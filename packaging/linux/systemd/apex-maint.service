# Unité systemd du moteur Apex Maint (installée par le paquet apex-maint).
# Personnalisation : systemctl edit apex-maint (fichier de surcharge, conservé aux mises à jour).

[Unit]
Description=Apex Maint — moteur GMAO et serveur web
Documentation=file:///usr/share/doc/apex-maint/INSTALLATION.md
After=network-online.target
Wants=network-online.target

[Service]
# Le moteur signale « prêt » (sd_notify) une fois le serveur web ouvert
Type=notify
NotifyAccess=main
User=apex-maint
Group=apex-maint
ExecStart=/usr/bin/apex-maint run --config /etc/apex-maint/apex-maint.toml

# Redémarrage après un crash, mais pas en boucle sur une erreur de démarrage
# (2 usage, 3 configuration invalide, 4 instance déjà active, 5 port indisponible, 6 base inaccessible)
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=2 3 4 5 6
# Arrêt propre : drivers, dernier lot d'historique, jeton local
KillSignal=SIGTERM
TimeoutStopSec=30

# Répertoires créés par systemd avec le bon propriétaire
StateDirectory=apex-maint
StateDirectoryMode=0750
LogsDirectory=apex-maint
LogsDirectoryMode=0750
RuntimeDirectory=apex-maint
RuntimeDirectoryMode=0750
UMask=0027

# Durcissement : le moteur ne lit que sa configuration et n'écrit que dans ses répertoires
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/apex-maint /var/log/apex-maint /run/apex-maint
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Aucune capacité : un port web inférieur à 1024 exige une surcharge
# (systemctl edit apex-maint → AmbientCapabilities=CAP_NET_BIND_SERVICE et
#  CapabilityBoundingSet=CAP_NET_BIND_SERVICE)
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
